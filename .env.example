# Copy to .env.local. Everything here is optional.

# Path to the Claude Code CLI, if it isn't found on its own.
# CLAUDE_CLI_PATH=/path/to/claude

# Path to the Codex CLI, same.
# CODEX_CLI_PATH=/path/to/codex

# Claude stops a chat turn once its estimated cost reaches this (USD). Default 5.00.
# CHAT_MAX_BUDGET_USD=5.00
